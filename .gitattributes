* text=auto eol=lf

# Windows entry points keep CRLF so cmd.exe / PowerShell behave predictably.
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.sqlite     binary
*.sqlite-wal binary
*.sqlite-shm binary
